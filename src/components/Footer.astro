---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const url = (p: string) => `${base}${p}`;
---

<footer class="bg-ink text-cream/85">
  <div class="max-w-7xl mx-auto px-5 sm:px-8 py-16 grid gap-12 md:grid-cols-4">
    <div class="md:col-span-2">
      <div class="font-display text-2xl text-cream mb-3">
        Scott's <span class="text-gold">Seafood</span>
      </div>
      <p class="text-sm leading-relaxed text-cream/70 max-w-md">
        Coastal cuisine and an elevated experience in the heart of downtown San Jose since 1985.
      </p>
      <div class="flex gap-4 mt-6">
        <a href="https://www.instagram.com/scottsseafoodsj/" aria-label="Instagram" class="text-cream/60 hover:text-gold transition">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41a3.71 3.71 0 0 1-1.38-.9 3.71 3.71 0 0 1-.9-1.38c-.16-.42-.36-1.06-.41-2.23C2.17 15.58 2.16 15.2 2.16 12s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41C8.42 2.17 8.8 2.16 12 2.16M12 0C8.74 0 8.33.01 7.05.07c-1.28.06-2.15.26-2.91.55-.79.31-1.46.72-2.13 1.38A5.88 5.88 0 0 0 .62 4.13c-.3.76-.5 1.63-.55 2.91C.01 8.33 0 8.74 0 12s.01 3.67.07 4.95c.06 1.28.26 2.15.55 2.91.31.79.72 1.46 1.38 2.13a5.88 5.88 0 0 0 2.13 1.38c.76.3 1.63.5 2.91.55C8.33 23.99 8.74 24 12 24s3.67-.01 4.95-.07c1.28-.06 2.15-.26 2.91-.55a5.88 5.88 0 0 0 2.13-1.38 5.88 5.88 0 0 0 1.38-2.13c.3-.76.5-1.63.55-2.91.06-1.28.07-1.69.07-4.95s-.01-3.67-.07-4.95c-.06-1.28-.26-2.15-.55-2.91a5.88 5.88 0 0 0-1.38-2.13A5.88 5.88 0 0 0 19.86.62c-.76-.3-1.63-.5-2.91-.55C15.67.01 15.26 0 12 0z"/><path d="M12 5.84a6.16 6.16 0 1 0 0 12.32 6.16 6.16 0 0 0 0-12.32zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8z"/><circle cx="18.41" cy="5.59" r="1.44"/></svg>
        </a>
        <a href="https://www.facebook.com/ScottsSeafoodSJ" aria-label="Facebook" class="text-cream/60 hover:text-gold transition">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.05V9.41c0-3.02 1.79-4.69 4.53-4.69 1.31 0 2.69.24 2.69.24v2.97h-1.52c-1.49 0-1.96.93-1.96 1.89v2.27h3.33l-.53 3.49h-2.8V24C19.61 23.1 24 18.1 24 12.07z"/></svg>
        </a>
      </div>
    </div>

    <div>
      <h4 class="text-sm uppercase tracking-widest text-gold mb-4">Visit</h4>
      <p class="text-sm leading-relaxed text-cream/70">
        200 S. First St, Suite 10<br />
        San Jose, CA 95113<br /><br />
        <a href="tel:+14089711700" class="hover:text-gold">(408) 971-1700</a>
      </p>
    </div>

    <div>
      <h4 class="text-sm uppercase tracking-widest text-gold mb-4">Hours</h4>
      <dl class="text-sm space-y-2 text-cream/70">
        <div><dt class="font-semibold text-cream/90">Lunch</dt><dd>Mon–Fri · 11:30 AM – 2 PM</dd></div>
        <div><dt class="font-semibold text-cream/90">Shuck & Stir</dt><dd>Mon–Fri · 4 PM – 6 PM</dd></div>
        <div><dt class="font-semibold text-cream/90">Dinner</dt><dd>Mon–Thu · 4 – 9 PM<br/>Fri–Sat · 4 – 9:30 PM</dd></div>
      </dl>
      <p class="text-xs italic text-cream/65 mt-3">
        Open Sundays for private events and select holidays.
      </p>
    </div>
  </div>

  <div class="border-t border-cream/10 bg-ink-soft">
    <div class="max-w-7xl mx-auto px-5 sm:px-8 py-8 grid md:grid-cols-2 gap-6 items-center">
      <div>
        <p class="text-gold uppercase tracking-widest text-xs mb-2">Newsletter</p>
        <p class="text-cream/80 text-sm leading-snug">One list across the Scott's San Jose family — restaurant, ballroom, catering, and the Club.</p>
      </div>
      <form
        action="https://scottsseafoodsj.us8.list-manage.com/subscribe/post?u=fab8fe5ff01093f4e48a5bd14&amp;id=e688913a46&amp;f_id=00e736e3f0"
        method="post"
        target="_blank"
        novalidate
        class="flex gap-2"
      >
        <label class="sr-only" for="footer-newsletter">Email address</label>
        <input id="footer-newsletter" name="EMAIL" type="email" required placeholder="you@example.com" class="flex-1 bg-cream-soft text-ink px-4 py-2.5 text-sm placeholder:text-ink/70 focus:outline-none focus:ring-2 focus:ring-gold" />
        <!-- Mailchimp honeypot — leave blank -->
        <div aria-hidden="true" style="position: absolute; left: -5000px;">
          <input type="text" name="b_fab8fe5ff01093f4e48a5bd14_e688913a46" tabindex="-1" value="" />
        </div>
        <button type="submit" name="subscribe" class="bg-gold text-ink text-xs font-semibold uppercase tracking-widest px-5 hover:bg-cream transition">Subscribe</button>
      </form>
    </div>
  </div>

  <div class="border-t border-cream/10">
    <div class="max-w-7xl mx-auto px-5 sm:px-8 py-8 grid sm:grid-cols-2 gap-4 text-xs text-cream/65">
      <div>
        <p class="text-gold uppercase tracking-widest text-xs mb-3">Part of the Scott's San Jose family</p>
        <div class="flex flex-wrap gap-x-5 gap-y-2 text-cream/70">
          <a href="https://squidly-inc.github.io/scotts-hospitality/" class="hover:text-gold">Hospitality</a>
          <a href="https://squidly-inc.github.io/scotts-ballroom/" class="hover:text-gold">Ballroom</a>
          <a href="https://squidly-inc.github.io/scotts-provisions/" class="hover:text-gold">Provisions</a>
          <a href="https://www.scottssocialclub.com/" class="hover:text-gold">Social Club</a>
        </div>
      </div>
      <div class="sm:text-right flex flex-col gap-2 sm:items-end">
        <p>© 2026 Scott's Seafood San Jose. All rights reserved.</p>
        <a href={url("/accessibility")} class="hover:text-gold">Accessibility</a>
      </div>
    </div>
  </div>
</footer>
