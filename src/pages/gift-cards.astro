---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Gift Cards | Scott's Seafood San Jose">
  <section class="bg-ink pt-32 pb-12 sm:pb-16">
    <div class="max-w-3xl mx-auto px-5 sm:px-8 text-center">
      <p class="text-gold uppercase tracking-[0.3em] text-xs mb-4">Gift Cards</p>
      <h1 class="font-display text-4xl sm:text-6xl text-cream mb-5 leading-tight">
        The gift of a great meal.
      </h1>
      <p class="text-cream/75 max-w-xl mx-auto leading-relaxed">
        Delivered digitally or by mail. Redeemable at the restaurant
        or for any private event.
      </p>
    </div>
  </section>

  <section class="bg-cream-soft py-16 sm:py-24">
    <div class="max-w-4xl mx-auto px-5 sm:px-8">
      <div class="bg-white shadow-xl overflow-hidden border-t-4 border-gold grid lg:grid-cols-5">
        <div class="lg:col-span-2 bg-teal-deep p-8 sm:p-12 flex flex-col justify-between text-cream">
          <div>
            <div class="font-display text-2xl mb-2">Scott's Seafood</div>
            <div class="text-gold uppercase tracking-widest text-xs mb-12">San Jose</div>
            <p class="font-display text-5xl mb-2">$100</p>
            <p class="text-cream/70 text-sm mb-12">Gift Card</p>
          </div>
          <p class="text-cream/60 text-xs leading-relaxed">
            Cards do not expire. Redeemable in-restaurant or against any
            private event balance.
          </p>
        </div>

        <div class="lg:col-span-3 p-8 sm:p-12">
          <h2 class="font-display text-2xl sm:text-3xl text-ink mb-6">Order a Gift Card</h2>
          <ul class="space-y-3 text-ink/80 mb-8">
            <li class="flex gap-3 items-start">
              <span class="text-gold-deep font-bold">·</span>
              <span>Any denomination from $25 to $1,000</span>
            </li>
            <li class="flex gap-3 items-start">
              <span class="text-gold-deep font-bold">·</span>
              <span>Send digitally for instant delivery</span>
            </li>
            <li class="flex gap-3 items-start">
              <span class="text-gold-deep font-bold">·</span>
              <span>Or have a physical card mailed to the recipient</span>
            </li>
            <li class="flex gap-3 items-start">
              <span class="text-gold-deep font-bold">·</span>
              <span>Custom message included</span>
            </li>
          </ul>
          <a
            href="https://www.toasttab.com/scotts-seafood-san-jose/giftcards"
            target="_blank"
            rel="noopener"
            class="inline-block bg-gold text-ink text-sm font-semibold uppercase tracking-widest px-8 py-4 hover:bg-ink hover:text-cream transition"
          >
            Buy a Gift Card →
          </a>
          <p class="text-ink/50 text-xs mt-4">Powered by Toast. Opens in a new tab.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-ink py-16 text-center">
    <div class="max-w-2xl mx-auto px-5 sm:px-8">
      <p class="text-cream/75">
        Questions? Email <a href="mailto:info@scottsseafoodsj.com" class="text-gold hover:text-cream">info@scottsseafoodsj.com</a> or call <a href="tel:+14089711700" class="text-gold hover:text-cream">(408) 971-1700</a>.
      </p>
    </div>
  </section>
</Layout>
