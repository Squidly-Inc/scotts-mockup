        { name: "Espresso Martini", desc: "Ketel One vodka, Baileys Irish cream, Kahlúa and fresh espresso.", price: "18" },
        { name: "Chocolate Martini", desc: "Vanilla vodka, Godiva chocolate liqueur, crème de cacao, heavy cream and chocolate syrup.", price: "17" },
        { name: "Carajillo", desc: "Licor 43 shaken with fresh espresso.", price: "16" },
        { name: "Nutty Irishman", desc: "Frangelico, Baileys Irish cream and coffee.", price: "16" },
        { name: "Irish Coffee", desc: "Jameson Irish whiskey, brown sugar and fresh coffee.", price: "16" },
        { name: "Italian Coffee", desc: "Disaronno Amaretto, coffee and whipped cream.", price: "16" },
        { name: "French Coffee", desc: "Grand Marnier and coffee topped with whipped cream.", price: "16" },
      ],
    },
    {
      title: "Dessert Wines & Digestifs",
      items: [
        { name: "Barton & Guestier · Sauternes · 2023", price: "14" },
        { name: "Inniskillin · Icewine Vidal · 2023", price: "20" },
        { name: "Gaja · Grappa Darmagi · Italy", price: "16" },
        { name: "Cockburn's 10yr · Tawny Port", price: "18" },
        { name: "Cockburn's · Ruby Port", price: "16" },
        { name: "Graham's 10yr · Tawny Port", price: "18" },
        { name: "Graham's 20yr · Tawny Port", price: "22" },
      ],
    },
  ],
};

const menus: Menu[] = [lunch, dinner, bar, happyHour, desserts];

const tabs = [
  ...menus.map((m) => ({ id: m.id, label: m.label })),
  { id: "wine", label: "Wine" },
];

const signatureDishes = [
  { name: "Scott's Cioppino", section: "Dinner · Classics", img: `${base}/photos/food-cioppino.jpg`, anchor: "#dinner" },
  { name: "Dungeness Crab Cakes", section: "Dinner · Starters", img: `${base}/photos/food-crab-cakes.jpg`, anchor: "#dinner" },
  { name: "Yellowtail Hamachi", section: "Dinner · Raw Bar", img: `${base}/photos/food-prawns.jpg`, anchor: "#dinner" },
  { name: "Molten Chocolate Cake", section: "Desserts", img: `${base}/photos/dessert-lava-cake.jpg`, anchor: "#desserts" },
];
---

<Layout title="Menus | Scott's Seafood San Jose">
  <section class="bg-ink pt-32 pb-12 sm:pb-16">
    <div class="max-w-5xl mx-auto px-5 sm:px-8 text-center">
      <p class="text-gold uppercase tracking-[0.3em] text-xs mb-4">The Menus</p>
      <h1 class="font-display text-4xl sm:text-6xl text-cream mb-4">Coastal cuisine, crafted daily.</h1>
      <p class="text-cream/70 max-w-xl mx-auto leading-relaxed">
        Lunch, dinner, bar, happy hour, and dessert — every menu, fully priced.
      </p>
    </div>
  </section>

  <!-- SIGNATURE DISHES -->
  <section class="bg-ink-soft py-10 sm:py-12">
    <div class="max-w-6xl mx-auto px-5 sm:px-8">
      <p class="text-gold uppercase tracking-[0.3em] text-xs text-center mb-6">Signature Dishes</p>
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">
        {signatureDishes.map((d) => (
          <a href={d.anchor} class="group block">
            <div class="aspect-square overflow-hidden bg-ink/20 mb-3">
              <img src={d.img} alt={d.name} class="w-full h-full object-cover group-hover:scale-105 transition duration-500" loading="lazy" />
            </div>
            <p class="text-cream text-sm font-display leading-tight">{d.name}</p>
            <p class="text-cream/55 text-xs uppercase tracking-widest mt-1">{d.section}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- TABS -->
  <section class="bg-ink sticky top-[88px] sm:top-[96px] z-40 border-t border-cream/10">
    <div class="max-w-5xl mx-auto px-5 sm:px-8 overflow-x-auto" tabindex="0" role="region" aria-label="Menu sections">
      <div class="flex gap-1 sm:gap-2 py-2">
        {tabs.map((t) => (
          <a
            href={`#${t.id}`}
            class="text-cream/70 hover:text-gold text-xs sm:text-sm uppercase tracking-widest font-semibold px-4 sm:px-6 py-3 whitespace-nowrap transition"
          >
            {t.label}
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-cream-soft py-16 sm:py-24">
    <div class="max-w-4xl mx-auto px-5 sm:px-8 space-y-20 sm:space-y-28">
      {menus.map((m) => (
        <div id={m.id} class="scroll-mt-[160px] sm:scroll-mt-[180px]">
          <div class="text-center mb-10 sm:mb-14">
            <p class="text-gold-deep uppercase tracking-[0.3em] text-xs mb-3">Menu</p>
            <h2 class="font-display text-3xl sm:text-5xl text-ink leading-tight">{m.label}</h2>
            {m.sub && <p class="text-ink/70 text-sm italic mt-3">{m.sub}</p>}
          </div>

          <div class="space-y-14 sm:space-y-16">
            {m.sections.map((s) => (
              <div>
                <h3 class="font-display text-xl sm:text-2xl text-ink mb-2 pb-3 border-b border-gold/40 uppercase tracking-wider">
                  {s.title}
                </h3>
                {s.note && <p class="text-ink/70 text-sm italic mt-3 mb-5">{s.note}</p>}
                <ul class="space-y-5 sm:space-y-6 mt-6">
                  {s.items.map((item) => (
                    <li class="flex justify-between items-start gap-4 sm:gap-6">
                      <div class="flex-1 min-w-0">
                        <p class="text-ink font-medium text-base sm:text-lg">
                          {item.name}
                          {item.raw && <sup class="text-gold-deep font-semibold ml-1" aria-label="Contains raw or undercooked ingredients">**</sup>}
                          {item.v && <span class="ml-2 inline-block text-[10px] font-bold uppercase tracking-wider bg-teal-deep/10 text-teal-deep px-1.5 py-0.5 align-middle" aria-label="Vegetarian">V</span>}
                          {item.vg && <span class="ml-2 inline-block text-[10px] font-bold uppercase tracking-wider bg-teal-deep/10 text-teal-deep px-1.5 py-0.5 align-middle" aria-label="Vegan">VG</span>}
                        </p>
                        {item.desc && <p class="text-ink/70 text-sm leading-relaxed mt-0.5">{item.desc}</p>}
                      </div>
                      <span class="text-ink/70 text-base sm:text-lg tabular-nums whitespace-nowrap">
                        {/^\d+$/.test(item.price) ? `$${item.price}` : item.price}
                      </span>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>

          <p class="text-center mt-12">
            <a href={url(`/menus/${m.id === "happy-hour" ? "happy-hour" : m.id === "desserts" ? "dessert-menu" : m.id + "-menu"}.pdf`)} target="_blank" rel="noopener" class="inline-block text-xs font-semibold uppercase tracking-widest text-gold-deep border-b border-gold-deep pb-1 hover:text-ink hover:border-ink transition">
              Download {m.label} PDF →
            </a>
          </p>
        </div>
      ))}

      <!-- WINE (PDF only) -->
      <div id="wine" class="scroll-mt-[160px] sm:scroll-mt-[180px]">
        <div class="text-center mb-10 sm:mb-14">
          <p class="text-gold-deep uppercase tracking-[0.3em] text-xs mb-3">Menu</p>
          <h2 class="font-display text-3xl sm:text-5xl text-ink leading-tight">Wine</h2>
          <p class="text-ink/70 text-sm italic mt-3">
            Sparkling, white, red, and reserve selections — by the glass and bottle.
          </p>
        </div>
        <div class="bg-paper border border-line p-8 sm:p-12 text-center">
          <p class="font-display text-xl text-ink mb-3">Full Wine List</p>
          <p class="text-ink/70 text-sm mb-3 max-w-md mx-auto">
            Organized by varietal — Chardonnay, Sauvignon Blanc, Cabernet, Pinot Noir, Merlot, and reserve pours.
          </p>
          <p class="text-ink/70 text-xs italic mb-6">
            Corkage fee: $40 per bottle (up to two 750 ml bottles).
          </p>
          <a href={url("/menus/wine-list.pdf")} target="_blank" rel="noopener" class="inline-block bg-gold text-ink text-xs font-semibold uppercase tracking-widest px-8 py-3 hover:bg-cream transition">
            Download Wine List PDF →
          </a>
        </div>
      </div>

      <!-- LEGEND + DISCLAIMER -->
      <div class="pt-8 border-t border-ink/10">
        <div class="flex flex-wrap gap-x-8 gap-y-3 justify-center text-sm text-ink/80 mb-6">
          <span><sup class="text-gold-deep font-semibold">**</sup> Consuming raw or undercooked meats, poultry, seafood, shellfish, or eggs may increase your risk of foodborne illness, especially if you have certain medical conditions.</span>
        </div>
        <div class="flex flex-wrap gap-x-6 gap-y-2 justify-center text-xs text-ink/70 mb-6">
          <span><span class="inline-block text-[10px] font-bold uppercase tracking-wider bg-teal-deep/10 text-teal-deep px-1.5 py-0.5 mr-1">V</span> Vegetarian</span>
          <span><span class="inline-block text-[10px] font-bold uppercase tracking-wider bg-teal-deep/10 text-teal-deep px-1.5 py-0.5 mr-1">VG</span> Vegan</span>
        </div>
        <p class="text-center text-ink/70 text-sm italic">
          Please inform your server of any food allergies or dietary restrictions — not all ingredients are listed on the menu.
        </p>
        <p class="text-center text-ink/70 text-sm italic mt-2">
          Menu and pricing subject to change. Menu prices subject to applicable taxes and surcharges.
        </p>
      </div>
    </div>
  </section>
</Layout>
