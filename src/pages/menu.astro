  { id: "entrees", label: "Entrées" },
  { id: "happy-hour", label: "Happy Hour" },
  { id: "cocktails", label: "Cocktails" },
  { id: "desserts", label: "Desserts" },
  { id: "wine", label: "Wine" },
];
---

<Layout title="Menus | Scott's Seafood San Jose">
  <section class="bg-ink pt-32 pb-12 sm:pb-16">
    <div class="max-w-5xl mx-auto px-5 sm:px-8 text-center">
      <p class="text-gold uppercase tracking-[0.3em] text-xs mb-4">The Menu</p>
      <h1 class="font-display text-4xl sm:text-6xl text-cream mb-4">Coastal cuisine, crafted daily.</h1>
      <p class="text-cream/70 max-w-xl mx-auto leading-relaxed">
        Discover the best of coastal cuisine and timeless steakhouse classics.
      </p>
    </div>
  </section>

  <!-- SIGNATURE DISHES -->
  <section class="bg-ink-soft py-10 sm:py-12">
    <div class="max-w-6xl mx-auto px-5 sm:px-8">
      <p class="text-gold uppercase tracking-[0.3em] text-xs text-center mb-6">Signature Dishes</p>
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">
        {signatureDishes.map((d) => (
          <a href={d.anchor} class="group block">
            <div class="aspect-square overflow-hidden bg-ink/20 mb-3">
              <img src={d.img} alt={d.name} class="w-full h-full object-cover group-hover:scale-105 transition duration-500" loading="lazy" />
            </div>
            <p class="text-cream text-sm font-display leading-tight">{d.name}</p>
            <p class="text-cream/55 text-xs uppercase tracking-widest mt-1">{d.section}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- TABS -->
  <section class="bg-ink sticky top-[88px] sm:top-[96px] z-40 border-t border-cream/10">
    <div class="max-w-5xl mx-auto px-5 sm:px-8 overflow-x-auto" tabindex="0" role="region" aria-label="Menu sections">
      <div class="flex gap-1 sm:gap-2 py-2">
        {menuTabs.map((t) => (
          <a
            href={`#${t.id}`}
            class="text-cream/70 hover:text-gold text-xs sm:text-sm uppercase tracking-widest font-semibold px-4 sm:px-6 py-3 whitespace-nowrap transition"
          >
            {t.label}
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-cream-soft py-16 sm:py-24">
    <div class="max-w-4xl mx-auto px-5 sm:px-8 space-y-16 sm:space-y-20">
      {sections.map((s) => (
        <div id={s.id}>
          <h2 class="font-display text-2xl sm:text-4xl text-ink mb-8 sm:mb-10 pb-3 border-b border-gold/40">
            {s.title}
          </h2>
          <ul class="space-y-5 sm:space-y-6">
            {s.items.map((item) => (
              <li class="flex justify-between items-baseline gap-4">
                <span class="text-ink font-medium text-base sm:text-lg">{item.name}</span>
                <span class="flex-1 border-b border-dotted border-ink/20 mb-1.5"></span>
                <span class="text-ink/70 text-base sm:text-lg tabular-nums">${item.price}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}

      <div id="happy-hour" class="bg-teal-deep -mx-5 sm:mx-0 sm:rounded-none px-6 sm:px-12 py-12 sm:py-14 text-cream">
        <p class="text-gold uppercase tracking-[0.3em] text-xs mb-3">Mon–Fri · 4 – 6 PM</p>
        <h2 class="font-display text-3xl sm:text-4xl mb-4">Happy Hour: Shuck & Stir Hour</h2>
        <p class="text-cream/85 leading-relaxed mb-8 max-w-xl">
          Oysters, classic cocktails, and elevated bar bites — done right.
        </p>

        <div class="grid sm:grid-cols-2 gap-x-10 gap-y-3 mb-8 max-w-2xl">
          <div>
            <h3 class="text-gold text-xs uppercase tracking-widest font-semibold mb-3">Oysters & Bites</h3>
            <ul class="space-y-2.5 text-sm">
              <li class="flex justify-between items-baseline gap-3"><span>Oysters on the Half Shell</span><span class="flex-1 border-b border-dotted border-cream/20 mb-1"></span><span class="text-cream/70 tabular-nums">$2 ea</span></li>
              <li class="flex justify-between items-baseline gap-3"><span>Shrimp Cocktail</span><span class="flex-1 border-b border-dotted border-cream/20 mb-1"></span><span class="text-cream/70 tabular-nums">$12</span></li>
              <li class="flex justify-between items-baseline gap-3"><span>Crispy Calamari</span><span class="flex-1 border-b border-dotted border-cream/20 mb-1"></span><span class="text-cream/70 tabular-nums">$12</span></li>
              <li class="flex justify-between items-baseline gap-3"><span>Crab Cake Slider</span><span class="flex-1 border-b border-dotted border-cream/20 mb-1"></span><span class="text-cream/70 tabular-nums">$10</span></li>
              <li class="flex justify-between items-baseline gap-3"><span>Bar Burger & Frites</span><span class="flex-1 border-b border-dotted border-cream/20 mb-1"></span><span class="text-cream/70 tabular-nums">$14</span></li>
            </ul>
          </div>
          <div>
            <h3 class="text-gold text-xs uppercase tracking-widest font-semibold mb-3">Drinks</h3>
            <ul class="space-y-2.5 text-sm">
              <li class="flex justify-between items-baseline gap-3"><span>Select Wines by the Glass</span><span class="flex-1 border-b border-dotted border-cream/20 mb-1"></span><span class="text-cream/70 tabular-nums">$9</span></li>
              <li class="flex justify-between items-baseline gap-3"><span>Draft Beer</span><span class="flex-1 border-b border-dotted border-cream/20 mb-1"></span><span class="text-cream/70 tabular-nums">$6</span></li>
              <li class="flex justify-between items-baseline gap-3"><span>Well Cocktails</span><span class="flex-1 border-b border-dotted border-cream/20 mb-1"></span><span class="text-cream/70 tabular-nums">$8</span></li>
              <li class="flex justify-between items-baseline gap-3"><span>House Martini</span><span class="flex-1 border-b border-dotted border-cream/20 mb-1"></span><span class="text-cream/70 tabular-nums">$10</span></li>
              <li class="flex justify-between items-baseline gap-3"><span>Old Fashioned</span><span class="flex-1 border-b border-dotted border-cream/20 mb-1"></span><span class="text-cream/70 tabular-nums">$11</span></li>
            </ul>
          </div>
        </div>

        <a href={url("/reservations")} class="inline-block bg-gold text-ink text-xs font-semibold uppercase tracking-widest px-7 py-3 hover:bg-cream transition">
          Reserve Bar Seating
        </a>
      </div>

      <div id="cocktails">
        <h2 class="font-display text-2xl sm:text-4xl text-ink mb-2 pb-3 border-b border-gold/40">Signature Cocktails</h2>
        <p class="text-ink/70 text-sm italic mb-8 mt-3">Offering subject to change. Ask your server for tonight's bar features.</p>

        <div class="grid sm:grid-cols-2 gap-6 sm:gap-8 mb-10">
          {cocktailsFeatured.map((c) => (
            <div class="bg-white shadow-sm overflow-hidden">
              <div class="aspect-[4/3] overflow-hidden bg-ink/10">
                <img src={c.img} alt={c.name} class="w-full h-full object-cover" />
              </div>
              <div class="p-5">
                <div class="flex justify-between items-baseline gap-3">
                  <h3 class="font-display text-lg text-ink">{c.name}</h3>
                  {c.price && <span class="text-ink/70 text-sm tabular-nums">${c.price}</span>}
                </div>
              </div>
            </div>
          ))}
        </div>

        <ul class="space-y-5 sm:space-y-6">
          {cocktails.map((c) => (
            <li class="flex justify-between items-start gap-4 sm:gap-6">
              <div class="flex-1">
                <p class="text-ink font-medium text-base sm:text-lg">{c.name}</p>
                <p class="text-ink/70 text-sm leading-relaxed">{c.desc}</p>
              </div>
              <span class="text-ink/70 text-base sm:text-lg tabular-nums whitespace-nowrap">${c.price}</span>
            </li>
          ))}
        </ul>

        <p class="text-center mt-8">
          <a href={url("/menus/cocktails-menu.pdf")} target="_blank" rel="noopener" class="inline-block text-xs font-semibold uppercase tracking-widest text-gold-deep border-b border-gold-deep pb-1 hover:text-ink hover:border-ink transition">
            Download Cocktails PDF →
          </a>
        </p>
      </div>

      <div id="desserts">
        <h2 class="font-display text-2xl sm:text-4xl text-ink mb-2 pb-3 border-b border-gold/40">Desserts</h2>
        <p class="text-ink/70 text-sm italic mb-8 mt-3">Offering subject to change.</p>

        <div class="grid sm:grid-cols-2 gap-6 sm:gap-8 mb-10">
          {dessertsFeatured.map((d) => (
            <div class="bg-white shadow-sm overflow-hidden">
              <div class="aspect-[4/3] overflow-hidden bg-ink/10">
                <img src={d.img} alt={d.name} class="w-full h-full object-cover" />
              </div>
              <div class="p-5">
                <div class="flex justify-between items-baseline gap-3">
                  <h3 class="font-display text-lg text-ink">{d.name}</h3>
                  <span class="text-ink/70 text-sm tabular-nums">${d.price}</span>
                </div>
              </div>
            </div>
          ))}
        </div>

        <ul class="space-y-5 sm:space-y-6">
          {desserts.map((d) => (
            <li class="flex justify-between items-start gap-4 sm:gap-6">
              <div class="flex-1">
                <p class="text-ink font-medium text-base sm:text-lg">{d.name}</p>
                <p class="text-ink/70 text-sm leading-relaxed">{d.desc}</p>
              </div>
              <span class="text-ink/70 text-base sm:text-lg tabular-nums whitespace-nowrap">${d.price}</span>
            </li>
          ))}
        </ul>

        <p class="text-center mt-8">
          <a href={url("/menus/dessert-menu.pdf")} target="_blank" rel="noopener" class="inline-block text-xs font-semibold uppercase tracking-widest text-gold-deep border-b border-gold-deep pb-1 hover:text-ink hover:border-ink transition">
            Download Desserts PDF →
          </a>
        </p>
      </div>

      <div id="wine">
        <h2 class="font-display text-2xl sm:text-4xl text-ink mb-2 pb-3 border-b border-gold/40">Wine</h2>
        <p class="text-ink/70 text-sm italic mb-8 mt-3">
          Offering subject to change. Full wine list below — sparkling, white, and red selections by the bottle.
          <span class="block mt-1">Corkage fee: $40 per bottle (up to two 750ml bottles).</span>
        </p>
        <div class="bg-paper border border-line p-6 sm:p-10 text-center">
          <p class="font-display text-xl text-ink mb-3">Full Wine List</p>
          <p class="text-ink/70 text-sm mb-6">
            All bottle pours, organized by varietal — Chardonnay, Sauvignon Blanc, Cabernet, Pinot Noir, Merlot, and more.
          </p>
          <a href={url("/menus/wine-list.pdf")} target="_blank" rel="noopener" class="inline-block bg-gold text-ink text-xs font-semibold uppercase tracking-widest px-8 py-3 hover:bg-cream transition">
            Download Wine List PDF →
          </a>
        </div>
      </div>

      <p class="text-center text-ink/70 text-sm italic pt-4">
        Please inform your food server of any food allergies. Menu and pricing subject to change. Menu prices subject to San Jose surcharge.
      </p>
    </div>
  </section>
</Layout>
